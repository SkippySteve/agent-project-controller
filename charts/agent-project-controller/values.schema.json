{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "controllerScheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "Equal",
                  "Exists"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "",
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "workspaceScheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "Equal",
                  "Exists"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "",
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "proxyScheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "Equal",
                  "Exists"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "",
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "controllerImagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "controllerDNS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "enum": [
            "ClusterFirst",
            "Default",
            "None",
            "ClusterFirstWithHostNet"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nameservers": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string"
              }
            },
            "searches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "None"
              }
            }
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "nameservers"
                ],
                "properties": {
                  "nameservers": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "proxyGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "disableSNIFilter": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "namespace",
            "selector",
            "port"
          ]
        }
      ]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "hostnames",
              "parentRefs"
            ],
            "properties": {
              "hostnames": {
                "minItems": 1
              },
              "parentRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "NETWORK_PROVIDER": {
          "enum": ["cilium", "network-policy"]
        },
        "NETWORK_POLICY_ENFORCEMENT_ACKNOWLEDGED": {
          "enum": ["true", "false"]
        },
        "NETWORK_POLICY_CLUSTER_CIDRS_JSON": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "NETWORK_PROVIDER": {
                "const": "network-policy"
              }
            },
            "required": ["NETWORK_PROVIDER"]
          },
          "then": {
            "required": [
              "NETWORK_POLICY_ENFORCEMENT_ACKNOWLEDGED",
              "NETWORK_POLICY_CLUSTER_CIDRS_JSON"
            ],
            "properties": {
              "NETWORK_POLICY_ENFORCEMENT_ACKNOWLEDGED": {
                "const": "true"
              },
              "NETWORK_POLICY_CLUSTER_CIDRS_JSON": {
                "minLength": 2
              }
            }
          }
        }
      ]
    }
  }
}
